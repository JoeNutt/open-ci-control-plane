{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:open-ci-control-plane:policy.catalog:v1",
  "title": "catalog/<policy>.yaml — a named, repository-independent policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "rule", "direction", "groups"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "rule": { "type": "string", "enum": ["direction"] },
    "direction": { "type": "string", "enum": ["lower_order_may_not_import_higher"] },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "order"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
