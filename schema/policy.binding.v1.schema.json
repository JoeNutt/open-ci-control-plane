{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:open-ci-control-plane:policy.binding:v1",
  "title": "bindings/<repository>.yaml — the catalog policies one repository uses, and its parameters",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "policies", "tests"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["use"],
        "properties": {
          "use": { "type": "string", "minLength": 1 },
          "import_roots": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["prefix", "path"],
              "properties": {
                "prefix": { "type": "string", "minLength": 1 },
                "path": { "type": "string" }
              }
            }
          },
          "paths": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow"],
      "properties": {
        "workflow": { "type": "string", "minLength": 1 },
        "always_run": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
